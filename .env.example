# Скопируйте в .env и заполните. deploy.sh сам найдёт старый .env на сервере, если он есть.

# --- обязательные ---
BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# не короче 24 символов
ADMIN_KEY=
# 16-256 символов: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=
# не короче 24 символов, одинаковый для API и релеера
RELAYER_INTERNAL_KEY=
ADMIN_IDS=

# --- домены ---
PORT=3000
MINI_APP_URL=https://moneymonkey.live
PUBLIC_BASE_URL=https://api.moneymonkey.live
WEBHOOK_URL=https://api.moneymonkey.live/webhook
BACKEND_URL=http://127.0.0.1:3000
RELAYER_URL=http://127.0.0.1:4011

# --- Telegram ---
BOT_USERNAME=xpepegiftbot
CHANNEL_USERNAME=GiftPep
SUPPORT_USERNAME=GiftPepeSupport
GIFT_RECEIVER_USERNAME=GiftPepeReleyer

# --- релеер (userbot для NFT). Сессию даёт `npm run relayer:login` ---
TG_API_ID=
TG_API_HASH=
TG_USER_SESSION=

# --- Gram (бывший TON) ---
TON_DESTINATION_WALLET=
TONCENTER_API_KEY=

# --- Sailor Moon: реальный Telegram gift_id, если подарок есть на аккаунте релеера ---
SAILOR_MOON_GIFT_ID=sailor_moon
SAILOR_MOON_PRICE_GRAM=1200

# --- Мины ---
MINES_MIN_BET=10
MINES_MAX_BET=50000
